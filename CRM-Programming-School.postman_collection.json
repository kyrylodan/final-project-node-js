{
  "info": {
    "name": "CRM Programming School API",
    "_postman_id": "7f247556-ff26-4fb5-bc38-07dfdf315f4a",
    "description": "Postman collection for the CRM Programming School project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "managerId",
      "value": ""
    },
    {
      "key": "actionToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign in",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response?.token?.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', response.token.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/auth/sign-in"
          }
        },
        {
          "name": "Get manager action info",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/activate/{{actionToken}}"
          }
        },
        {
          "name": "Complete activation or recovery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"manager1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/activate/{{actionToken}}"
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Get applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?page=1&limit=25&sortBy=created_at&sortOrder=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "25"
                },
                {
                  "key": "sortBy",
                  "value": "created_at"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Export applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications/export?sortBy=created_at&sortOrder=desc"
          }
        },
        {
          "name": "Add application comment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"First contact completed\"\n}"
            },
            "url": "{{baseUrl}}/applications/{{applicationId}}/comment"
          }
        },
        {
          "name": "Update application",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In work\",\n  \"group\": \"FS-25\",\n  \"sum\": \"1000\",\n  \"alreadyPaid\": \"300\"\n}"
            },
            "url": "{{baseUrl}}/applications/{{applicationId}}"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get application statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/stats"
          }
        },
        {
          "name": "Get managers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/managers?page=1&limit=4"
          }
        },
        {
          "name": "Create manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@example.com\",\n  \"name\": \"Test\",\n  \"surname\": \"Manager\"\n}"
            },
            "url": "{{baseUrl}}/admin/managers"
          }
        },
        {
          "name": "Generate activation link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/managers/{{managerId}}/activate-link"
          }
        },
        {
          "name": "Generate recovery link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/managers/{{managerId}}/recovery-link"
          }
        },
        {
          "name": "Ban manager",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isBanned\": true\n}"
            },
            "url": "{{baseUrl}}/admin/managers/{{managerId}}/ban"
          }
        },
        {
          "name": "Unban manager",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isBanned\": false\n}"
            },
            "url": "{{baseUrl}}/admin/managers/{{managerId}}/ban"
          }
        }
      ]
    }
  ]
}
